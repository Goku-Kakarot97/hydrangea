<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hydrangea</groupId>
        <artifactId>hydrangea-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>hydrangea-examples</artifactId>
    <name>Hydrangea examples</name>
    <description>Runnable examples, the tests that span several modules (including ArchitectureTest), and the build step that merges every module's classes into target/classes at the repository root (so "java -cp target/classes io.hydrangea.examples.EchoServer" and the scripts under benchmark/, interop/ ... keep working). Nothing is published from here.</description>

    <dependencies>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-quic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-grpc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-amqp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-mqtt</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-kafka</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-postgres</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-mysql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.hydrangea</groupId>
            <artifactId>hydrangea-http</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>merge-classes</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../target/classes</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource><directory>${project.basedir}/../hydrangea-core/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-quic/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-http/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-grpc/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-amqp/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-mqtt/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-redis/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-kafka/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-postgres/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-sql/target/classes</directory></resource>
                                <resource><directory>${project.basedir}/../hydrangea-mysql/target/classes</directory></resource>
                                <resource><directory>${project.build.outputDirectory}</directory></resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
