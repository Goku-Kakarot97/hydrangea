# One load run (benchmark/src/h2/CapLoad.java, Hydrangea client for both servers so the load is identical). __NAME__ and __TARGET__ are filled in.
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  labels: {app.kubernetes.io/part-of: hydrangea-bench}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  template:
    metadata:
      labels: {app.kubernetes.io/part-of: hydrangea-bench, app: __NAME__}
    spec:
      restartPolicy: Never
      containers:
        - name: load
          image: eclipse-temurin:21-jre
          command: ["/bin/sh", "-c"]
          args:
            - |
              H=__TARGET__.iris.svc.cluster.local
              C() { echo "## $*"; java -Xmx256m -cp /jars/hydrangea.jar:/jars/gbench.jar h2.CapLoad $H 8080 "$@" 2>&1 | grep -E "RESULT|Exception"; }
              # scenario inflight connections warmup seconds ioThreads
              C grpc-16 16  2 5 15 2
              C grpc-16 64  2 5 15 2
              C grpc-16 256 4 5 15 2
              C grpc-4k 64  2 5 15 2
              echo DONE
          resources:
            requests: {cpu: "1", memory: 512Mi}
            limits: {cpu: "2", memory: 640Mi}
          volumeMounts: [{name: jars, mountPath: /jars}]
      volumes:
        - name: jars
          configMap: {name: hydrangea-gj-jars}
