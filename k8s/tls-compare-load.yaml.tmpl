# One TLS load run against __TARGET__ (benchmark/src/h2/CapLoad.java with the Hydrangea client, trusting the throw-away certificate; the same client and load for every server).
apiVersion: batch/v1
kind: Job
metadata:
  name: __NAME__
  labels: {app.kubernetes.io/part-of: hydrangea-bench}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 900
  template:
    metadata:
      labels: {app.kubernetes.io/part-of: hydrangea-bench, app: __NAME__}
    spec:
      restartPolicy: Never
      containers:
        - name: load
          image: eclipse-temurin:21-jre
          command: ["/bin/sh", "-c"]
          args:
            - |
              H=__TARGET__.iris.svc.cluster.local
              CP=/jars/hydrangea.jar:/jars/bench.jar
              C() { echo "## tls $*"; java -Xmx256m -Dtls.truststore=/certs/trust.p12 -cp $CP h2.CapLoad $H 8443 "$@" 2>&1 | grep -E "RESULT|Exception"; }
              # scenario inflight connections warmup seconds ioThreads
              C h1-plain 64 64 5 15 2
              C h1-plain 256 256 5 15 2
              C h1-echo1k 64 64 5 15 2
              C h2-plain 64 2 5 15 2
              C h2-echo1k 64 2 5 15 2
              C h1-close-plain 16 16 5 15 2
              echo DONE
          resources:
            requests: {cpu: "1", memory: 512Mi}
            limits: {cpu: "2", memory: 640Mi}
          volumeMounts: [{name: jars, mountPath: /jars}, {name: certs, mountPath: /certs}]
      volumes:
        - name: jars
          configMap: {name: hydrangea-ut-jars}
        - name: certs
          configMap: {name: hydrangea-tls2-certs}
