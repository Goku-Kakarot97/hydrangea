<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.goku-kakarot97</groupId>
    <artifactId>hydrangea-parent</artifactId>
    <version>1.0.1</version>
    <packaging>pom</packaging>
    <name>Hydrangea</name>
    <description>Small, modern non-blocking network framework on top of Java NIO: a core, and protocol modules built on it</description>
    <url>https://github.com/Goku-Kakarot97/hydrangea</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Goku-Kakarot97</id>
            <name>Goku-Kakarot97</name>
            <url>https://github.com/Goku-Kakarot97</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Goku-Kakarot97/hydrangea.git</connection>
        <developerConnection>scm:git:git@github.com:Goku-Kakarot97/hydrangea.git</developerConnection>
        <url>https://github.com/Goku-Kakarot97/hydrangea</url>
        <tag>v1.0.1</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/Goku-Kakarot97/hydrangea/issues</url>
    </issueManagement>

    <modules>
        <module>hydrangea-core</module>
        <module>hydrangea-quic</module>
        <module>hydrangea-http</module>
        <module>hydrangea-grpc</module>
        <module>hydrangea-amqp</module>
        <module>hydrangea-mqtt</module>
        <module>hydrangea-redis</module>
        <module>hydrangea-kafka</module>
        <module>hydrangea-sql</module>
        <module>hydrangea-postgres</module>
        <module>hydrangea-mysql</module>
        <module>hydrangea-micrometer</module>
         <module>hydrangea-examples</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- The libraries have no dependencies of their own (ArchitectureTest checks it); external artifacts are JUnit, for tests, and Micrometer, in the
         hydrangea-micrometer module only (optional, nothing else uses it). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.10.1</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.7</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.8.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- Publishing to Maven Central through the Sonatype Central Portal: `mvn -Prelease -DskipTests deploy`.
         Needs, in ~/.m2/settings.xml, a <server> with id `central` holding the portal's user token, and a GPG key whose public part is on a key server
         (the plugin signs with the default key; `-Dgpg.keyname=...` picks another, `-Dgpg.passphrase=...` or the GPG agent supplies the passphrase).
         The examples module is built but not published (see its pom). -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <notimestamp>true</notimestamp>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <excludeArtifacts>
                                <artifact>hydrangea-examples</artifact>      <!-- built with the rest, never published; the bundle is uploaded from the last module, so that module must not skip -->
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
